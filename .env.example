# ozania.io : variables d'environnement. Aucune valeur réelle ne doit être commitée.
# Copier ce fichier en .env.local pour le développement ; en ligne, utiliser les
# paramètres sécurisés de l'hébergeur.

# --- Navigateur (préfixe VITE_ : visible dans le code publié, jamais de secret ici) ---

# Mode du formulaire de contact. Vide ou absent = mode brouillon : rien n'est envoyé,
# le visiteur copie ou télécharge sa demande. Mettre "api" pour appeler POST /api/contact
# (uniquement une fois le serveur configuré avec les 3 variables ci-dessous).
VITE_CONTACT_DELIVERY=

# Adresse de contact affichée, qui active le bouton « ouvrir ma messagerie » (mailto).
# Laisser vide tant que le destinataire d'ozania.io n'est pas confirmé.
VITE_CONTACT_EMAIL=

# --- Serveur (api/contact.ts) : l'envoi n'est actif que si les 3 sont renseignées ---

# Destinataire des demandes. Aucune valeur par défaut dans le code.
CONTACT_TO_EMAIL=

# Expéditeur vérifié auprès du fournisseur (Resend).
CONTACT_FROM_EMAIL=

# Clé API Resend. Secret : paramètres sécurisés de l'hébergeur uniquement.
RESEND_API_KEY=
